# ZYCROP Backend Environment Configuration
# Copy this file to .env and customize for your setup

# ─────────────────────────────────────────────────────────────────────────────
# MONGODB - REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Local MongoDB (for offline operation)
MONGO_URL=mongodb://localhost:27017/ZYCROP

# Cloud MongoDB Atlas (if you prefer cloud persistence)
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/ZYCROP?retryWrites=true


# ─────────────────────────────────────────────────────────────────────────────
# OPENAI API - OPTIONAL (for chatbot features)
# ─────────────────────────────────────────────────────────────────────────────

# Get key from: https://platform.openai.com/api-keys
# Leave empty to disable OpenAI features
OPENAI_API_KEY=

# Model to use (gpt-4o-mini is cheaper, gpt-4o for better quality)
OPENAI_MODEL=gpt-4o-mini


# ─────────────────────────────────────────────────────────────────────────────
# BHASHINI API - OPTIONAL (for translation + voice)
# ─────────────────────────────────────────────────────────────────────────────

# Government of India's AI translation service
# Register at: https://bhashini.gov.in/
# Leave empty for offline-only translation via IndicTrans2

BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# BACKEND SERVER
# ─────────────────────────────────────────────────────────────────────────────

# Port to run Uvicorn on
BACKEND_PORT=8888

# Bind to all interfaces (for local network access)
BACKEND_HOST=0.0.0.0

# Number of worker processes
WORKERS=1


# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log to file (optional)
LOG_FILE=logs/zycrop.log


# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND - For CORS + integrations
# ─────────────────────────────────────────────────────────────────────────────

# Your frontend dev server address
FRONTEND_URL=http://localhost:8081
