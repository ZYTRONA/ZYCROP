# ZYCROP Frontend Environment Configuration
# Copy this file to .env and customize for your setup

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND API
# ─────────────────────────────────────────────────────────────────────────────

# For production Expo Go, use your Mac's LAN IP
# Your current network IP: 10.145.74.160
EXPO_PUBLIC_BACKEND_API_URL=http://10.145.74.160:8888

# For emulator testing on Android:
# EXPO_PUBLIC_BACKEND_API_URL=http://10.0.2.2:8888

# For iOS simulator:
# EXPO_PUBLIC_BACKEND_API_URL=http://127.0.0.1:8888

# For local network (same as backend host):
# EXPO_PUBLIC_BACKEND_API_URL=http://localhost:8888


# ─────────────────────────────────────────────────────────────────────────────
# OPENAI API - OPTIONAL (for chatbot)
# ─────────────────────────────────────────────────────────────────────────────

# Get key from: https://platform.openai.com/api-keys
# Leave empty to disable OpenAI features (falls back to local LLM via backend)
EXPO_PUBLIC_OPENAI_API_KEY=

# Model to use
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
